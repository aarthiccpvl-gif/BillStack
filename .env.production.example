# Copy to .env.production and replace every value marked change-me.
# Never commit .env.production.

# --- public origins ---------------------------------------------------------
APP_URL=https://billing.example.com
FRONTEND_URL=https://billing.example.com
COOKIE_DOMAIN=billing.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- database (also read by docker-compose.prod.yml) ------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
DATABASE_URL=mysql://invoice:change-me-app@mysql:3306/invoice_db

# --- auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- initial users (set before the first seed; remove afterwards) -----------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_PASSWORD=

# --- storage ----------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./var/storage
UPLOAD_MAX_MB=5
ATTACHMENT_MAX_MB=10

# --- pdf --------------------------------------------------------------------
PUPPETEER_EXECUTABLE_PATH=
PDF_CONCURRENCY=2
PDF_TIMEOUT_MS=30000

# --- sharing ----------------------------------------------------------------
SHARE_LINK_TTL_DAYS=30

# --- ops --------------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
