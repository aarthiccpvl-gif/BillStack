# =============================================================================
#  Internal Invoice & Quotation Management System — environment template
#  Copy to .env (`npm run setup:env` fills the secrets for you). Never commit .env.
# =============================================================================

# --- core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5175
TZ=Asia/Kolkata

# --- database ---------------------------------------------------------------
DATABASE_URL=mysql://invoice:invoice@localhost:3306/invoice_db

# --- auth (Phase 2) ---------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- initial seed users (Phase 2; set before running the seed) ---------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_PASSWORD=

# --- storage ----------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./var/storage
STORAGE_BUCKET=invoice-documents
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_MAX_MB=5
ATTACHMENT_MAX_MB=10

# --- pdf (Phase 4) ----------------------------------------------------------
PDF_ENGINE=puppeteer
PUPPETEER_EXECUTABLE_PATH=
PDF_CONCURRENCY=2
PDF_TIMEOUT_MS=30000

# --- email ------------------------------------------------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Company Billing <billing@example.com>"
MAIL_BCC_ARCHIVE=

# --- sharing / feature flags ------------------------------------------------
SHARE_LINK_TTL_DAYS=30
FEATURE_WHATSAPP=false
FEATURE_PAYMENTS=false
FEATURE_MANUAL_PAYMENTS=true

# --- ops --------------------------------------------------------------------
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
