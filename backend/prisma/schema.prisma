// =============================================================================
//  Internal Invoice & Quotation Management System — database schema
//
//  Design:    docs/01-data-model-erd.md, docs/02-prisma-schema-design.md
//  Decisions: docs/11-decisions.md
//
//  Deliberately absent (decisions Q2 and Q14):
//    invoice_payments  — payment status is set manually; `amountPaid` carries the figure
//    email_messages    — no email sending in this project; sharing is download + link
//
//  Conventions:
//    money      DECIMAL(18,4)   rounded to the currency's own precision on write
//    quantity   DECIMAL(18,3)
//    percentage DECIMAL(9,4)
//    document dates are DATE (never DATETIME) so a 31 March invoice cannot drift a year
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums ----

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocType {
  QUOTATION
  INVOICE
  CREDIT_NOTE // reserved — the GST-compliant amendment path, not implemented
}

enum EntityType {
  QUOTATION
  INVOICE
  CUSTOMER
  ITEM
  TEMPLATE
  COMPANY
  USER
  ROLE
  MASTER
  REPORT
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

enum DiscountMode {
  NONE
  PERCENT
  AMOUNT
}

enum SymbolPosition {
  PREFIX
  SUFFIX
}

enum SeparatorStyle {
  WESTERN
  INDIAN
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum ResetPolicy {
  FINANCIAL_YEAR
  NEVER
}

enum TaxScope {
  INTRA_STATE
  INTER_STATE
  UNION_TERRITORY
  NONE
}

enum TaxTreatment {
  REGISTERED
  UNREGISTERED
  COMPOSITION
  OVERSEAS
  SEZ
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FileKind {
  GENERATED_PDF
  ATTACHMENT
  LOGO
  SIGNATURE
  SEAL
  FAVICON
  REPORT
}

enum ShareChannel {
  LINK
  WHATSAPP
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  CANCELLED
  VOID
  // OVERDUE is derived from dueDate, never stored, so it cannot go stale.
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  ROLE_PERMISSIONS_UPDATED
  SETTINGS_UPDATED
  COMPANY_UPDATED
  COMPANY_ASSET_UPDATED
  BANK_ACCOUNT_CREATED
  BANK_ACCOUNT_UPDATED
  BANK_ACCOUNT_DELETED
  MASTER_CREATED
  MASTER_UPDATED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_ARCHIVED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_VERSION_PUBLISHED
  TEMPLATE_DEFAULT_CHANGED
  QUOTATION_CREATED
  QUOTATION_UPDATED
  QUOTATION_STATUS_CHANGED
  QUOTATION_VIEWED
  QUOTATION_CONVERTED
  QUOTATION_DELETED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_STATUS_CHANGED
  INVOICE_VIEWED
  INVOICE_CANCELLED
  INVOICE_VOIDED
  INVOICE_DELETED
  PAYMENT_STATUS_CHANGED
  DOCUMENT_PDF_GENERATED
  DOCUMENT_DOWNLOADED
  DOCUMENT_SHARED
  SHARE_REVOKED
  REPORT_EXPORTED
  BULK_DOWNLOAD
}

// ------------------------------------------------------ identity & access --

model Role {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  /// Roles flagged read-only are refused every non-GET request by a global guard,
  /// before any controller runs. This is the structural backstop behind per-route
  /// permission checks.
  isReadOnly  Boolean  @default(false) @map("is_read_only")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(80)
  module      String  @db.VarChar(40)
  action      String  @db.VarChar(40)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 Int        @id @default(autoincrement())
  name               String     @db.VarChar(150)
  email              String     @unique @db.VarChar(190)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  roleId             Int        @map("role_id")
  status             UserStatus @default(ACTIVE)
  phone              String?    @db.VarChar(30)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  /// Bumped to invalidate every existing session for this user at once.
  tokenVersion       Int        @default(0) @map("token_version")
  lastLoginAt        DateTime?  @map("last_login_at")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  createdById        Int?       @map("created_by")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  role              Role           @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  quotationsCreated Quotation[]    @relation("QuotationCreatedBy")
  invoicesCreated   Invoice[]      @relation("InvoiceCreatedBy")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       Int       @map("user_id")
  /// Only the hash is stored; the token itself lives solely in the httpOnly cookie.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Set when this token was rotated; reuse of a rotated token revokes the family.
  replacedById BigInt?   @map("replaced_by_id")
  ip           String?   @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// -------------------------------------------------- company & configuration --

model CompanySettings {
  id                 Int     @id @default(1)
  companyName        String  @map("company_name") @db.VarChar(200)
  legalName          String? @map("legal_name") @db.VarChar(200)
  addressLine1       String? @map("address_line1") @db.VarChar(255)
  addressLine2       String? @map("address_line2") @db.VarChar(255)
  city               String? @db.VarChar(100)
  state              String? @db.VarChar(100)
  /// GST state code — one half of the place-of-supply decision.
  stateCode          String? @map("state_code") @db.VarChar(4)
  country            String? @db.VarChar(100)
  postalCode         String? @map("postal_code") @db.VarChar(20)
  phone              String? @db.VarChar(40)
  email              String? @db.VarChar(190)
  website            String? @db.VarChar(190)
  gstin              String? @db.VarChar(20)
  pan                String? @db.VarChar(20)
  cin                String? @db.VarChar(30)
  otherRegistrations Json?   @map("other_registrations")

  logoFileId      BigInt? @map("logo_file_id")
  faviconFileId   BigInt? @map("favicon_file_id")
  /// Authorised signature image (decision Q13).
  signatureFileId BigInt? @map("signature_file_id")
  /// Company seal / stamp image — its own upload and its own area on the document.
  sealFileId      BigInt? @map("seal_file_id")
  signatureLabel  String? @map("signature_label") @db.VarChar(120)

  primaryColor   String @default("#1b5e40") @map("primary_color") @db.VarChar(9)
  secondaryColor String @default("#6b7770") @map("secondary_color") @db.VarChar(9)
  defaultFont    String @default("Poppins") @map("default_font") @db.VarChar(60)

  baseCurrencyCode        String @default("INR") @map("base_currency_code") @db.Char(3)
  financialYearStartMonth Int    @default(4) @map("financial_year_start_month")

  defaultInvoiceTemplateId   Int?    @map("default_invoice_template_id")
  defaultQuotationTemplateId Int?    @map("default_quotation_template_id")
  defaultTermsInvoice        String? @map("default_terms_invoice") @db.Text
  defaultTermsQuotation      String? @map("default_terms_quotation") @db.Text
  defaultNotes               String? @map("default_notes") @db.Text
  /// False until an administrator has filled in the real company details.
  isConfigured               Boolean @default(false) @map("is_configured")

  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bankAccounts CompanyBankAccount[]

  @@map("company_settings")
}

model CompanyBankAccount {
  id                  Int          @id @default(autoincrement())
  companyId           Int          @default(1) @map("company_id")
  bankName            String       @map("bank_name") @db.VarChar(150)
  accountName         String       @map("account_name") @db.VarChar(150)
  accountNumber       String       @map("account_number") @db.VarChar(60)
  ifsc                String?      @db.VarChar(20)
  swift               String?      @db.VarChar(20)
  branch              String?      @db.VarChar(150)
  /// Set when an account should only be offered for one currency (a USD invoice
  /// usually prints a different account than an INR one).
  currencyCode        String?      @map("currency_code") @db.Char(3)
  paymentInstructions String?      @map("payment_instructions") @db.Text
  isDefault           Boolean      @default(false) @map("is_default")
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@map("company_bank_accounts")
}

/// Key/value configuration that must be changeable without a deployment.
model AppSetting {
  key         String   @id @db.VarChar(80)
  valueJson   Json     @map("value_json")
  description String?  @db.VarChar(255)
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model FinancialYear {
  id        Int                 @id @default(autoincrement())
  code      String              @unique @db.VarChar(9)
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  isCurrent Boolean             @default(false) @map("is_current")
  status    FinancialYearStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")

  quotations Quotation[]
  invoices   Invoice[]
  sequences  DocumentSequence[]

  @@index([startDate, endDate])
  @@map("financial_years")
}

/// Configurable numbering format. Default: {PREFIX}{SEQ}/{FY_LONG} → FT001/2026-2027
model NumberingSeries {
  id          Int         @id @default(autoincrement())
  docType     DocType     @map("doc_type")
  prefix      String      @db.VarChar(20)
  pattern     String      @db.VarChar(80)
  padding     Int         @default(3)
  startNumber Int         @default(1) @map("start_number")
  resetPolicy ResetPolicy @default(FINANCIAL_YEAR) @map("reset_policy")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sequences DocumentSequence[]

  @@index([docType, isActive])
  @@map("numbering_series")
}

/// One counter row per (series, financial year), incremented under SELECT … FOR UPDATE
/// inside the same transaction as the document insert.
model DocumentSequence {
  id                Int      @id @default(autoincrement())
  numberingSeriesId Int      @map("numbering_series_id")
  financialYearId   Int?     @map("financial_year_id")
  lastNumber        Int      @default(0) @map("last_number")
  updatedAt         DateTime @updatedAt @map("updated_at")

  series        NumberingSeries @relation(fields: [numberingSeriesId], references: [id])
  financialYear FinancialYear?  @relation(fields: [financialYearId], references: [id])

  @@unique([numberingSeriesId, financialYearId])
  @@index([financialYearId])
  @@map("document_sequences")
}

model Currency {
  code           String         @id @db.Char(3)
  name           String         @db.VarChar(80)
  symbol         String         @db.VarChar(8)
  decimalPlaces  Int            @default(2) @map("decimal_places")
  symbolPosition SymbolPosition @default(PREFIX) @map("symbol_position")
  separatorStyle SeparatorStyle @default(WESTERN) @map("separator_style")
  isActive       Boolean        @default(true) @map("is_active")
  sortOrder      Int            @default(0) @map("sort_order")

  customers  Customer[]
  items      Item[]
  quotations Quotation[]
  invoices   Invoice[]

  @@map("currencies")
}

/// Manually entered rates for consolidated reporting (decision Q3: INR base).
model ExchangeRate {
  id            BigInt   @id @default(autoincrement())
  fromCurrency  String   @map("from_currency") @db.Char(3)
  toCurrency    String   @map("to_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime @map("effective_date") @db.Date
  source        String   @default("MANUAL") @db.VarChar(30)
  createdById   Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@map("exchange_rates")
}

model TaxType {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(20)
  name      String   @db.VarChar(80)
  scope     TaxScope @default(NONE)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  rates TaxRate[]

  @@map("tax_types")
}

model TaxRate {
  id            Int       @id @default(autoincrement())
  taxTypeId     Int       @map("tax_type_id")
  name          String    @db.VarChar(80)
  rate          Decimal   @db.Decimal(9, 4)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")

  taxType        TaxType            @relation(fields: [taxTypeId], references: [id])
  items          Item[]
  groupLinks     TaxGroupRate[]
  quotationTaxes QuotationItemTax[]
  invoiceTaxes   InvoiceItemTax[]

  @@index([taxTypeId, isActive])
  @@map("tax_rates")
}

/// A named bundle so a user picks "GST 18% (Intra-state)" once and the engine
/// expands it into CGST 9% + SGST 9% on the line.
model TaxGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  scope     TaxScope @default(NONE)
  /// Total percentage, denormalised for display and sorting only.
  totalRate Decimal  @default(0) @map("total_rate") @db.Decimal(9, 4)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  rates TaxGroupRate[]
  items Item[]

  @@map("tax_groups")
}

model TaxGroupRate {
  taxGroupId Int @map("tax_group_id")
  taxRateId  Int @map("tax_rate_id")

  group TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)
  rate  TaxRate  @relation(fields: [taxRateId], references: [id])

  @@id([taxGroupId, taxRateId])
  @@index([taxRateId])
  @@map("tax_group_rates")
}

model Unit {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(60)
  isActive Boolean @default(true) @map("is_active")

  items Item[]

  @@map("units")
}

model ItemCategory {
  id       Int          @id @default(autoincrement())
  name     String       @unique @db.VarChar(100)
  parentId Int?         @map("parent_id")
  status   RecordStatus @default(ACTIVE)

  items Item[]

  @@map("item_categories")
}

// ------------------------------------------------------------------ masters --

model Customer {
  id                     Int          @id @default(autoincrement())
  customerCode           String       @unique @map("customer_code") @db.VarChar(40)
  name                   String       @db.VarChar(200)
  companyName            String?      @map("company_name") @db.VarChar(200)
  contactPerson          String?      @map("contact_person") @db.VarChar(150)
  email                  String?      @db.VarChar(190)
  phone                  String?      @db.VarChar(40)
  altPhone               String?      @map("alt_phone") @db.VarChar(40)
  gstin                  String?      @db.VarChar(20)
  pan                    String?      @db.VarChar(20)
  otherTaxId             String?      @map("other_tax_id") @db.VarChar(40)
  taxTreatment           TaxTreatment @default(REGISTERED) @map("tax_treatment")
  /// The other half of the place-of-supply decision.
  placeOfSupplyStateCode String?      @map("place_of_supply_state_code") @db.VarChar(4)
  defaultCurrencyCode    String       @default("INR") @map("default_currency_code") @db.Char(3)
  paymentTermsDays       Int          @default(30) @map("payment_terms_days")
  notes                  String?      @db.Text
  status                 RecordStatus @default(ACTIVE)
  createdById            Int?         @map("created_by")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  currency   Currency          @relation(fields: [defaultCurrencyCode], references: [code])
  addresses  CustomerAddress[]
  contacts   CustomerContact[]
  quotations Quotation[]
  invoices   Invoice[]

  @@index([name])
  @@index([status])
  @@index([defaultCurrencyCode])
  @@map("customers")
}

model CustomerAddress {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  type       AddressType
  label      String?     @db.VarChar(60)
  line1      String?     @db.VarChar(255)
  line2      String?     @db.VarChar(255)
  city       String?     @db.VarChar(100)
  state      String?     @db.VarChar(100)
  stateCode  String?     @map("state_code") @db.VarChar(4)
  country    String?     @db.VarChar(100)
  postalCode String?     @map("postal_code") @db.VarChar(20)
  isDefault  Boolean     @default(false) @map("is_default")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@map("customer_addresses")
}

model CustomerContact {
  id          Int     @id @default(autoincrement())
  customerId  Int     @map("customer_id")
  name        String  @db.VarChar(150)
  designation String? @db.VarChar(100)
  email       String? @db.VarChar(190)
  phone       String? @db.VarChar(40)
  isPrimary   Boolean @default(false) @map("is_primary")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

model Item {
  id                Int          @id @default(autoincrement())
  itemCode          String       @unique @map("item_code") @db.VarChar(40)
  name              String       @db.VarChar(200)
  description       String?      @db.Text
  type              ItemType     @default(SERVICE)
  unitId            Int?         @map("unit_id")
  defaultRate       Decimal      @default(0) @map("default_rate") @db.Decimal(18, 4)
  currencyCode      String       @default("INR") @map("currency_code") @db.Char(3)
  defaultTaxRateId  Int?         @map("default_tax_rate_id")
  defaultTaxGroupId Int?         @map("default_tax_group_id")
  /// Required on Indian GST invoices (decision Q10).
  hsnSacCode        String?      @map("hsn_sac_code") @db.VarChar(20)
  categoryId        Int?         @map("category_id")
  status            RecordStatus @default(ACTIVE)
  createdById       Int?         @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  unit            Unit?           @relation(fields: [unitId], references: [id])
  currency        Currency        @relation(fields: [currencyCode], references: [code])
  defaultTaxRate  TaxRate?        @relation(fields: [defaultTaxRateId], references: [id])
  defaultTaxGroup TaxGroup?       @relation(fields: [defaultTaxGroupId], references: [id])
  category        ItemCategory?   @relation(fields: [categoryId], references: [id])
  quotationItems  QuotationItem[]
  invoiceItems    InvoiceItem[]

  @@index([name])
  @@index([status])
  @@index([categoryId])
  @@index([unitId])
  @@index([currencyCode])
  @@index([defaultTaxRateId])
  @@index([defaultTaxGroupId])
  @@map("items")
}

// ---------------------------------------------------------------- templates --

model Template {
  id          Int          @id @default(autoincrement())
  key         String       @db.VarChar(40)
  name        String       @db.VarChar(100)
  docType     DocType      @map("doc_type")
  /// Selects the renderer layout in backend/src/render/registry.ts
  engineKey   String       @map("engine_key") @db.VarChar(40)
  description String?      @db.VarChar(255)
  isDefault   Boolean      @default(false) @map("is_default")
  status      RecordStatus @default(ACTIVE)
  createdById Int?         @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  versions TemplateVersion[]

  @@unique([key, docType])
  @@index([docType, status])
  @@map("templates")
}

/// Immutable once PUBLISHED — editing clones to version n+1, so a historical
/// document always re-renders exactly as it was issued.
model TemplateVersion {
  id          Int            @id @default(autoincrement())
  templateId  Int            @map("template_id")
  version     Int
  configJson  Json           @map("config_json")
  changeNote  String?        @map("change_note") @db.VarChar(255)
  status      TemplateStatus @default(DRAFT)
  publishedAt DateTime?      @map("published_at")
  createdById Int?           @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  template   Template    @relation(fields: [templateId], references: [id])
  quotations Quotation[]
  invoices   Invoice[]

  @@unique([templateId, version])
  @@map("template_versions")
}

// --------------------------------------------------------------- quotations --

model Quotation {
  id              BigInt @id @default(autoincrement())
  number          String @unique @db.VarChar(60)
  financialYearId Int    @map("financial_year_id")
  customerId      Int    @map("customer_id")

  /// Frozen copies: editing a master must never rewrite a document's history.
  customerSnapshot        Json    @map("customer_snapshot")
  billingAddressSnapshot  Json?   @map("billing_address_snapshot")
  shippingAddressSnapshot Json?   @map("shipping_address_snapshot")
  companySnapshot         Json    @map("company_snapshot")
  placeOfSupplyStateCode  String? @map("place_of_supply_state_code") @db.VarChar(4)

  currencyCode          String  @map("currency_code") @db.Char(3)
  currencySymbol        String  @map("currency_symbol") @db.VarChar(8)
  currencyDecimalPlaces Int     @default(2) @map("currency_decimal_places")
  exchangeRateToBase    Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(18, 8)
  baseCurrencyCode      String  @map("base_currency_code") @db.Char(3)
  baseTotal             Decimal @default(0) @map("base_total") @db.Decimal(18, 4)

  documentDate    DateTime        @map("document_date") @db.Date
  expiryDate      DateTime?       @map("expiry_date") @db.Date
  referenceNumber String?         @map("reference_number") @db.VarChar(80)
  subject         String?         @db.VarChar(255)
  status          QuotationStatus @default(DRAFT)

  discountMode   DiscountMode @default(NONE) @map("discount_mode")
  discountValue  Decimal      @default(0) @map("discount_value") @db.Decimal(18, 4)
  subtotal       Decimal      @default(0) @db.Decimal(18, 4)
  discountTotal  Decimal      @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxableTotal   Decimal      @default(0) @map("taxable_total") @db.Decimal(18, 4)
  taxTotal       Decimal      @default(0) @map("tax_total") @db.Decimal(18, 4)
  adjustment     Decimal      @default(0) @db.Decimal(18, 4)
  roundOff       Decimal      @default(0) @map("round_off") @db.Decimal(18, 4)
  /// The user's intent, kept separately: a total that happens to be whole has a
  /// zero round-off, which must not be mistaken for "rounding is switched off".
  roundOffEnabled Boolean     @default(true) @map("round_off_enabled")
  grandTotal     Decimal      @default(0) @map("grand_total") @db.Decimal(18, 4)
  taxSummaryJson Json         @map("tax_summary_json")

  notes               String? @db.Text
  terms               String? @db.Text
  customerMessage     String? @map("customer_message") @db.Text
  paymentInstructions String? @map("payment_instructions") @db.Text
  bankAccountId       Int?    @map("bank_account_id")
  showBankDetails     Boolean @default(true) @map("show_bank_details")

  templateId        Int   @map("template_id")
  templateVersionId Int   @map("template_version_id")
  currentVersion    Int   @default(1) @map("current_version")
  customFieldsJson  Json? @map("custom_fields_json")

  convertedInvoiceId BigInt?   @unique @map("converted_invoice_id")
  sentAt             DateTime? @map("sent_at")
  firstViewedAt      DateTime? @map("first_viewed_at")
  acceptedAt         DateTime? @map("accepted_at")
  declinedAt         DateTime? @map("declined_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason") @db.VarChar(255)
  archivedAt         DateTime? @map("archived_at")
  /// Soft delete, drafts only (decision Q8). The number is never reused.
  deletedAt          DateTime? @map("deleted_at")

  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  financialYear   FinancialYear       @relation(fields: [financialYearId], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  currency        Currency            @relation(fields: [currencyCode], references: [code])
  templateVersion TemplateVersion     @relation(fields: [templateVersionId], references: [id])
  createdBy       User                @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  items           QuotationItem[]
  revisions       QuotationRevision[]
  invoices        Invoice[]           @relation("InvoiceFromQuotation")

  @@index([customerId, documentDate])
  @@index([status, documentDate])
  @@index([financialYearId, status])
  @@index([documentDate])
  @@index([templateVersionId])
  @@index([currencyCode])
  @@index([createdById])
  @@map("quotations")
}

model QuotationItem {
  id                   BigInt       @id @default(autoincrement())
  quotationId          BigInt       @map("quotation_id")
  lineNumber           Int          @map("line_number")
  sortOrder            Int          @default(0) @map("sort_order")
  itemId               Int?         @map("item_id")
  itemCode             String?      @map("item_code") @db.VarChar(40)
  name                 String       @db.VarChar(200)
  description          String?      @db.Text
  hsnSacCode           String?      @map("hsn_sac_code") @db.VarChar(20)
  unitCode             String?      @map("unit_code") @db.VarChar(20)
  quantity             Decimal      @db.Decimal(18, 3)
  rate                 Decimal      @db.Decimal(18, 4)
  discountMode         DiscountMode @default(NONE) @map("discount_mode")
  discountValue        Decimal      @default(0) @map("discount_value") @db.Decimal(18, 4)
  discountAmount       Decimal      @default(0) @map("discount_amount") @db.Decimal(18, 4)
  lineGross            Decimal      @default(0) @map("line_gross") @db.Decimal(18, 4)
  lineNet              Decimal      @default(0) @map("line_net") @db.Decimal(18, 4)
  allocatedDocDiscount Decimal      @default(0) @map("allocated_doc_discount") @db.Decimal(18, 4)
  taxableAmount        Decimal      @default(0) @map("taxable_amount") @db.Decimal(18, 4)
  taxAmount            Decimal      @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal            Decimal      @default(0) @map("line_total") @db.Decimal(18, 4)
  taxGroupId           Int?         @map("tax_group_id")
  isTaxExempt          Boolean      @default(false) @map("is_tax_exempt")
  exemptReason         String?      @map("exempt_reason") @db.VarChar(120)

  quotation Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      Item?              @relation(fields: [itemId], references: [id])
  taxes     QuotationItemTax[]

  @@index([quotationId, sortOrder])
  @@index([itemId])
  @@map("quotation_items")
}

model QuotationItemTax {
  id              BigInt  @id @default(autoincrement())
  quotationItemId BigInt  @map("quotation_item_id")
  taxRateId       Int     @map("tax_rate_id")
  taxTypeKey      String  @map("tax_type_key") @db.VarChar(20)
  label           String  @db.VarChar(60)
  ratePercent     Decimal @map("rate_percent") @db.Decimal(9, 4)
  taxableAmount   Decimal @map("taxable_amount") @db.Decimal(18, 4)
  taxAmount       Decimal @map("tax_amount") @db.Decimal(18, 4)

  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  taxRate       TaxRate       @relation(fields: [taxRateId], references: [id])

  @@index([quotationItemId])
  @@index([taxRateId])
  @@map("quotation_item_taxes")
}

/// Append-only. Version n records the transition into version n+1 and keeps the
/// full before/after snapshots, so any historical version can be re-rendered.
model QuotationRevision {
  id               BigInt   @id @default(autoincrement())
  quotationId      BigInt   @map("quotation_id")
  version          Int
  changedById      Int      @map("changed_by")
  changeReason     String?  @map("change_reason") @db.VarChar(500)
  previousDataJson Json     @map("previous_data_json")
  newDataJson      Json     @map("new_data_json")
  diffSummaryJson  Json?    @map("diff_summary_json")
  createdAt        DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@unique([quotationId, version])
  @@map("quotation_revisions")
}

// ----------------------------------------------------------------- invoices --

model Invoice {
  id              BigInt  @id @default(autoincrement())
  number          String  @unique @db.VarChar(60)
  financialYearId Int     @map("financial_year_id")
  quotationId     BigInt? @map("quotation_id")
  customerId      Int     @map("customer_id")

  customerSnapshot        Json    @map("customer_snapshot")
  billingAddressSnapshot  Json?   @map("billing_address_snapshot")
  shippingAddressSnapshot Json?   @map("shipping_address_snapshot")
  companySnapshot         Json    @map("company_snapshot")
  placeOfSupplyStateCode  String? @map("place_of_supply_state_code") @db.VarChar(4)

  /// Locked once the invoice leaves DRAFT (decision Q4).
  currencyCode          String  @map("currency_code") @db.Char(3)
  currencySymbol        String  @map("currency_symbol") @db.VarChar(8)
  currencyDecimalPlaces Int     @default(2) @map("currency_decimal_places")
  exchangeRateToBase    Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(18, 8)
  baseCurrencyCode      String  @map("base_currency_code") @db.Char(3)
  baseTotal             Decimal @default(0) @map("base_total") @db.Decimal(18, 4)

  documentDate     DateTime      @map("document_date") @db.Date
  dueDate          DateTime?     @map("due_date") @db.Date
  paymentTermsDays Int           @default(30) @map("payment_terms_days")
  referenceNumber  String?       @map("reference_number") @db.VarChar(80)
  subject          String?       @db.VarChar(255)
  status           InvoiceStatus @default(DRAFT)

  discountMode     DiscountMode @default(NONE) @map("discount_mode")
  discountValue    Decimal      @default(0) @map("discount_value") @db.Decimal(18, 4)
  subtotal         Decimal      @default(0) @db.Decimal(18, 4)
  discountTotal    Decimal      @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxableTotal     Decimal      @default(0) @map("taxable_total") @db.Decimal(18, 4)
  taxTotal         Decimal      @default(0) @map("tax_total") @db.Decimal(18, 4)
  adjustment       Decimal      @default(0) @db.Decimal(18, 4)
  roundOff         Decimal      @default(0) @map("round_off") @db.Decimal(18, 4)
  /// The user's intent, kept separately: a total that happens to be whole has a
  /// zero round-off, which must not be mistaken for "rounding is switched off".
  roundOffEnabled  Boolean      @default(true) @map("round_off_enabled")
  grandTotal       Decimal      @default(0) @map("grand_total") @db.Decimal(18, 4)
  /// Set by an Admin alongside the payment status (decision Q2 — no ledger).
  /// outstanding = grandTotal − amountPaid
  amountPaid       Decimal      @default(0) @map("amount_paid") @db.Decimal(18, 4)
  paymentReference String?      @map("payment_reference") @db.VarChar(120)
  taxSummaryJson   Json         @map("tax_summary_json")

  notes               String? @db.Text
  terms               String? @db.Text
  customerMessage     String? @map("customer_message") @db.Text
  paymentInstructions String? @map("payment_instructions") @db.Text
  bankAccountId       Int?    @map("bank_account_id")
  showBankDetails     Boolean @default(true) @map("show_bank_details")

  templateId        Int   @map("template_id")
  templateVersionId Int   @map("template_version_id")
  currentVersion    Int   @default(1) @map("current_version")
  customFieldsJson  Json? @map("custom_fields_json")

  issuedAt      DateTime? @map("issued_at")
  sentAt        DateTime? @map("sent_at")
  firstViewedAt DateTime? @map("first_viewed_at")
  paidAt        DateTime? @map("paid_at")
  cancelledAt   DateTime? @map("cancelled_at")
  voidedAt      DateTime? @map("voided_at")
  cancelReason  String?   @map("cancel_reason") @db.VarChar(255)
  archivedAt    DateTime? @map("archived_at")
  deletedAt     DateTime? @map("deleted_at")

  createdById Int      @map("created_by")
  updatedById Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  financialYear   FinancialYear     @relation(fields: [financialYearId], references: [id])
  sourceQuotation Quotation?        @relation("InvoiceFromQuotation", fields: [quotationId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  currency        Currency          @relation(fields: [currencyCode], references: [code])
  templateVersion TemplateVersion   @relation(fields: [templateVersionId], references: [id])
  createdBy       User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items           InvoiceItem[]
  revisions       InvoiceRevision[]

  @@index([customerId, documentDate])
  @@index([status, dueDate])
  @@index([financialYearId, status])
  @@index([documentDate])
  @@index([quotationId])
  @@index([templateVersionId])
  @@index([currencyCode])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceItem {
  id                   BigInt       @id @default(autoincrement())
  invoiceId            BigInt       @map("invoice_id")
  lineNumber           Int          @map("line_number")
  sortOrder            Int          @default(0) @map("sort_order")
  itemId               Int?         @map("item_id")
  itemCode             String?      @map("item_code") @db.VarChar(40)
  name                 String       @db.VarChar(200)
  description          String?      @db.Text
  hsnSacCode           String?      @map("hsn_sac_code") @db.VarChar(20)
  unitCode             String?      @map("unit_code") @db.VarChar(20)
  quantity             Decimal      @db.Decimal(18, 3)
  rate                 Decimal      @db.Decimal(18, 4)
  discountMode         DiscountMode @default(NONE) @map("discount_mode")
  discountValue        Decimal      @default(0) @map("discount_value") @db.Decimal(18, 4)
  discountAmount       Decimal      @default(0) @map("discount_amount") @db.Decimal(18, 4)
  lineGross            Decimal      @default(0) @map("line_gross") @db.Decimal(18, 4)
  lineNet              Decimal      @default(0) @map("line_net") @db.Decimal(18, 4)
  allocatedDocDiscount Decimal      @default(0) @map("allocated_doc_discount") @db.Decimal(18, 4)
  taxableAmount        Decimal      @default(0) @map("taxable_amount") @db.Decimal(18, 4)
  taxAmount            Decimal      @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal            Decimal      @default(0) @map("line_total") @db.Decimal(18, 4)
  taxGroupId           Int?         @map("tax_group_id")
  isTaxExempt          Boolean      @default(false) @map("is_tax_exempt")
  exemptReason         String?      @map("exempt_reason") @db.VarChar(120)

  invoice Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?            @relation(fields: [itemId], references: [id])
  taxes   InvoiceItemTax[]

  @@index([invoiceId, sortOrder])
  @@index([itemId])
  @@map("invoice_items")
}

model InvoiceItemTax {
  id            BigInt  @id @default(autoincrement())
  invoiceItemId BigInt  @map("invoice_item_id")
  taxRateId     Int     @map("tax_rate_id")
  taxTypeKey    String  @map("tax_type_key") @db.VarChar(20)
  label         String  @db.VarChar(60)
  ratePercent   Decimal @map("rate_percent") @db.Decimal(9, 4)
  taxableAmount Decimal @map("taxable_amount") @db.Decimal(18, 4)
  taxAmount     Decimal @map("tax_amount") @db.Decimal(18, 4)

  invoiceItem InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  taxRate     TaxRate     @relation(fields: [taxRateId], references: [id])

  @@index([invoiceItemId])
  @@index([taxRateId])
  @@map("invoice_item_taxes")
}

model InvoiceRevision {
  id               BigInt   @id @default(autoincrement())
  invoiceId        BigInt   @map("invoice_id")
  version          Int
  changedById      Int      @map("changed_by")
  changeReason     String?  @map("change_reason") @db.VarChar(500)
  previousDataJson Json     @map("previous_data_json")
  newDataJson      Json     @map("new_data_json")
  diffSummaryJson  Json?    @map("diff_summary_json")
  createdAt        DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, version])
  @@map("invoice_revisions")
}

// ------------------------------------------------- files, sharing, audit ----

model DocumentFile {
  id                BigInt     @id @default(autoincrement())
  entityType        EntityType @map("entity_type")
  entityId          BigInt?    @map("entity_id")
  kind              FileKind
  /// Which revision of the document this PDF represents.
  documentVersion   Int?       @map("document_version")
  templateVersionId Int?       @map("template_version_id")
  storageKey        String     @map("storage_key") @db.VarChar(500)
  fileName          String     @map("file_name") @db.VarChar(255)
  mimeType          String     @map("mime_type") @db.VarChar(120)
  sizeBytes         Int        @map("size_bytes")
  checksumSha256    String?    @map("checksum_sha256") @db.Char(64)
  createdById       Int?       @map("created_by")
  createdAt         DateTime   @default(now()) @map("created_at")

  @@index([entityType, entityId, kind])
  @@map("document_files")
}

/// Secure public link (decision Q9): opaque token, 30-day default TTL, revocable,
/// and it can only ever read an already-generated PDF.
model DocumentShare {
  id           BigInt       @id @default(autoincrement())
  entityType   EntityType   @map("entity_type")
  entityId     BigInt       @map("entity_id")
  tokenHash    String       @unique @map("token_hash") @db.VarChar(255)
  channel      ShareChannel @default(LINK)
  expiresAt    DateTime?    @map("expires_at")
  revokedAt    DateTime?    @map("revoked_at")
  viewCount    Int          @default(0) @map("view_count")
  lastViewedAt DateTime?    @map("last_viewed_at")
  createdById  Int          @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("document_shares")
}

/// Append-only: the application exposes no update or delete path for these rows.
model AuditLog {
  id                BigInt      @id @default(autoincrement())
  userId            Int?        @map("user_id")
  /// Snapshotted so the trail survives a user rename or deactivation.
  userEmailSnapshot String?     @map("user_email_snapshot") @db.VarChar(190)
  action            AuditAction
  entityType        EntityType  @map("entity_type")
  entityId          BigInt?     @map("entity_id")
  entityLabel       String?     @map("entity_label") @db.VarChar(190)
  ip                String?     @db.VarChar(64)
  userAgent         String?     @map("user_agent") @db.VarChar(255)
  requestId         String?     @map("request_id") @db.VarChar(40)
  previousDataJson  Json?       @map("previous_data_json")
  newDataJson       Json?       @map("new_data_json")
  metadataJson      Json?       @map("metadata_json")
  createdAt         DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
