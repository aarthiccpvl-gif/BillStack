{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    /* Production resolves @app/shared through node_modules to shared/dist,
       so the build must typecheck against the built declarations, not the source. */
    "paths": {
      "@app/shared": ["../shared/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**/*", "dist"]
}
