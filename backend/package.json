{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Internal Invoice & Quotation Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "prisma:validate": "dotenv -e ../.env -- prisma validate",
    "prisma:format": "prisma format",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset"
  },
  "dependencies": {
    "@app/shared": "*",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^5.21.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "puppeteer": "^25.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.8.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.4"
  }
}
